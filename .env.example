# ─────────────────────────────────────────────
# Mahoney Tech Solutions — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
#
# When deploying to Vercel / Railway / Render:
#   Add each of these as Environment Variables
#   in your hosting dashboard.
# ─────────────────────────────────────────────

# ── API Server ────────────────────────────────

# Port the Express API server listens on
# (Vercel manages this automatically — leave blank on Vercel)
PORT=8080

# Secret used to sign sessions (any long random string)
SESSION_SECRET=replace_with_a_long_random_string

# ── Resend (Contact Form Emails) ──────────────
# Get your key at https://resend.com → API Keys
# Must start with re_
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
