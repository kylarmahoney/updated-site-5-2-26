# Railway Environment Variables
# Add each of these in your Railway project → Variables tab

# Required — get from resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Required — any long random string, used for session security
SESSION_SECRET=change-me-to-something-long-and-random

# Required — Railway sets this automatically, but confirm it is present
PORT=8080

# Required — tells the server it is running in production mode
NODE_ENV=production
